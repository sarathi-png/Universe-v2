# TMDB API key (required)
TMDB_API_KEY=your_tmdb_api_key_here

# Server port (default 3001)
PORT=3001

# Optional proxy for scraping (e.g., http://user:pass@host:port)
HTTPS_PROXY=
HTTP_PROXY=

# Render keep-warm URL (optional, prevents free tier sleep)
RENDER_EXTERNAL_URL=
KEEP_WARM_URL=

# Torrent engine limits
MAX_ACTIVE_TORRENTS=3
IDLE_TIMEOUT_MS=900000
MEMORY_WARNING_BYTES=419430400
